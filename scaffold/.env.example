# ============================================================================
# 骨架栈环境变量（复制为 .env 后修改；.env 不入库、不进交付物）
#   cp .env.example .env
# ============================================================================

# --- 关系库（PostgreSQL） ---
PG_USER=rp
PG_PASSWORD=rp_change_me
PG_DB=road_pavement
PG_PORT=55432          # 本机 5432 已被其它服务占用，故用 55432

# --- 接入 Broker（EMQX） ---
MQTT_PORT=18883        # 本机 1883 空闲，但统一避让，用 18883
MQTT_DASHBOARD_PORT=18083
EMQX_USER=admin
EMQX_PASSWORD=public

# --- 对象存储（MinIO） ---
MINIO_USER=rpadmin
MINIO_PASSWORD=minio_change_me
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003

# --- 监控（Grafana） ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_PORT=3001      # 本机 3000 已被占用

# --- 接入服务（M2 ingest） ---
INGEST_PORT=8010
INGEST_TOPIC=g228/+/+/axle

# --- API 服务（M6） ---
API_PORT=8001          # 本机 8000 已被占用
