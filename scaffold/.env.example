# ============================================================================
# 骨架栈环境变量（复制为 .env 后修改；.env 不入库、不进交付物）
#   cp .env.example .env
# ============================================================================

# --- 关系库（PostgreSQL） ---
PG_USER=rp
PG_PASSWORD=rp_change_me
PG_DB=road_pavement
PG_PORT=55432          # 本机 5432 已被其它服务占用，故用 55432

# --- 接入 Broker（EMQX） ---
MQTT_PORT=18883        # 本机 1883 空闲，但统一避让，用 18883
MQTT_DASHBOARD_PORT=18083
EMQX_USER=admin
EMQX_PASSWORD=public

# --- 对象存储（MinIO） ---
MINIO_USER=rpadmin
MINIO_PASSWORD=minio_change_me
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003

# --- 监控（Grafana） ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_PORT=3001      # 本机 3000 已被占用

# --- 接入服务（M2 ingest） ---
INGEST_PORT=8010
INGEST_TOPIC=g228/+/+/axle

# --- API 服务（M6） ---
API_PORT=8001          # 本机 8000 已被占用

# --- 平台各模块的宿主端口（M4/M5/M7/M8/M9/M10） ---
#   ★★★★★ 补于 2026-10-13：这 6 个键原先**只写在 compose 的 `:-` 默认值里**，
#   本文件从 2026-09-14 建仓起就没再动过，而 compose 在 2026-09-15（b9b9df2）
#   一次性把这 6 个服务的端口加了进去 —— 于是**这里缺了 6 个**。
#   因为都有默认值，不声明照样跑，所以缺了**不响**；而本文件被 12 份文档引用
#   （含全部 6 个模块的 README，每份都写「首次 cp .env.example .env」），
#   照做的人**配不全自己模块的端口**。
#   ⇒ 值就是 compose 里原来的默认值，写在这里**不改变任何行为**，
#     只是让「可配置」这件事**看得见**。守卫见
#     tests/contract/test_runner_completeness.py §4。
GOVERNANCE_PORT=8020
FUSION_PORT=8021
SEMANTIC_PORT=8022
APPS_PORT=8023
CONSOLE_PORT=8024
AGENT_PORT=8025
