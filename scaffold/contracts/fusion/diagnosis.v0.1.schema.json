{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rp.local/contracts/fusion/diagnosis.v0.1.schema.json",
  "title": "诊断三元组 v0.1（M5 产出 · 草案）",
  "description": "M5 融合辨析的输出。所谓三元组＝(对象, 病害/状态, 证据)。消费方：M8 应用层、M9 管理台。状态：草案，C 组定稿后升 v1。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "diagnosis_id",
    "object_type",
    "object_ref",
    "finding",
    "evidence",
    "produced_at",
    "batch_no"
  ],
  "properties": {
    "diagnosis_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "object_type": {
      "enum": [
        "路段",
        "结构层",
        "测点",
        "车道",
        "构件"
      ],
      "description": "诊断对象类型，对应 7 大对象域的实体粒度"
    },
    "object_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "对象标识（路段桩号/测点编码/构件编号）"
    },
    "finding": {
      "type": "string",
      "minLength": 2,
      "maxLength": 500,
      "description": "结论。必须是人能读懂的句子，不接受只有编码。"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "description": "证据链。**至少一条**——无证据的结论不得进库。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_table",
          "metric",
          "value"
        ],
        "properties": {
          "source_table": {
            "type": "string"
          },
          "metric": {
            "type": "string"
          },
          "value": {
            "type": [
              "number",
              "string"
            ]
          },
          "unit": {
            "type": "string"
          }
        }
      }
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1,
      "description": "置信度。未标定的模型**必须留 null**，不得填一个假数字。"
    },
    "batch_no": {
      "type": "string",
      "description": "来源批次，必须已 truth_flag=true（真值门禁）"
    },
    "produced_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
