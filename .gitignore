# ============ 虚拟环境与缓存 ============
.docxvenv/
.venv/
__pycache__/
*.py[cod]
*.pyo
.uvcache/
.uvpython/

# ============ 本机 Docker 配置目录（DOCKER_CONFIG 指向此处）============
# 内含 buildx 构建状态与本机 docker 客户端配置，属机器本地状态，不入库。
.dockerhome/
.pytest_cache/

# ============ 临时产物 ============
.tmp/
.tmpstubs/
.render/
*.tmp

# ============ 图件流水线的本地依赖与 QA 中间件 ============
# .pylibs/ 是 PyMuPDF 的本地安装目录（约 26 MB，供技能自带的 PDF 审计脚本使用），
# .mplcache/ 是 matplotlib 字体缓存，.qarenders/ 是视觉 QA 用的印刷尺寸栅格与
# 抽查裁切块——三者都可由 gen_arch_figures.py / qa_render.py 再生，不入库。
.pylibs/
.mplcache/
.qarenders/

# ============ 大体积来源资料与中间产物 ============
# docpipe/materials/ 是标准与设计文件的原始 PDF/DOCX（约 128 MB），属"输入"而非
# "产出"，且可用原始来源重新获取；docpipe/bands/ 是制图流水线的中间裁剪图
# （约 17 MB，可由 materials/ + crop_bands.py 再生）。
# 若要做全量镜像（连原始资料一起纳管），执行：
#     git add -f docpipe/materials docpipe/bands && git commit -m "纳入原始资料"
docpipe/materials/
docpipe/bands/
pgdata/
miniodata/
grafanadata/
*.zst
.DS_Store

# ============ 不上传的目录（2026-09-15 决定）============
# output/  交付物：报告、图件、课题计划文档（约 37 MB）。属"成果"而非"代码"，
#          且含课题乙等未定稿材料，不进代码仓库。
# docpipe/ 文档与图件生成流水线 + 原始素材（标准规范 PDF 等）。素材涉版权、
#          体积大，且只有重出文档/图时才需要。
# 代码仓库只保留 scaffold/（平台代码，0.3 MB）+ 两份说明文档。
# 唯一例外见 scaffold/sql/：契约②的真源 DDL 与数据字典**必须**随代码走，
# 因为 compose 要挂载它建库、契约测试要读它比对，它们不是"成果"而是"契约"。
output/
# ⚠ git 规则：父目录被排除后**无法**再单独放行其中的文件。
#   所以要用「先全排、再放行目录、再全排、最后放行文件」这条链，
#   否则 !docpipe/scripts/gen_er_weidi.py 是**无效**的（实测 check-ignore 仍报 ignored）。
docpipe/*
!docpipe/scripts/
docpipe/scripts/*
!docpipe/scripts/gen_er_weidi.py

# work/ 只提交各目录的 README（说明"这个目录干嘛的"），
# 里面学生的实验脚本/造数记录/草稿全部忽略，避免合并冲突。
scaffold/work/*
!scaffold/work/README.md
!scaffold/work/*/
!scaffold/work/*/README.md
